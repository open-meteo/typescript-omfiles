{
  "name": "@openmeteo/file-format-wasm",
  "version": "0.0.20",
  "description": "WebAssembly bindings for OmFileFormat",
  "repository": {
    "type": "git",
    "url": "https://github.com/open-meteo/typescript-omfiles.git",
    "directory": "packages/file-format-wasm"
  },
  "type": "module",
  "exports": {
    "import": {
      "node": {
        "default": "./dist/om_file_format.node.js"
      },
      "default": {
        "default": "./dist/om_file_format.web.js"
      }
    },
    "require": {
      "node": {
        "default": "./dist/om_file_format.node.js"
      },
      "default": {
        "default": "./dist/om_file_format.web.js"
      }
    }
  },
  "files": [
    "dist/om_file_format.node.js",
    "dist/om_file_format.node.wasm",
    "dist/om_file_format.web.js",
    "dist/om_file_format.web.wasm"
  ],
  "scripts": {
    "build": "sudo docker run --rm -v $(pwd):/src -u $(id -u):$(id -g) emscripten/emsdk:4.0.12 make -C /src",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "file-format",
    "wasm",
    "webassembly",
    "open-meteo"
  ],
  "license": "GPL-2.0-only"
}
